<style>
:root{--bg:#faf6f0;--fg:#2a2118;--ac:#d9633b;--ac2:#3b7dd9;--cd:#fff;--mu:#7a6c5c;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
