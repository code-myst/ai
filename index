const S=[...document.querySelectorAll(".pg")],D=[...dots.children];
function go(n){cur=Math.max(0,Math.min(P.length-1,n));S.forEach((s,i)=>{s.className="pg"+(i==cur?" on":i<cur?" off":"")});D.forEach((d,i)=>d.className=i==cur?"on":"");document.getElementById("bar").style.width=(cur/(P.length-1)*100)+"%"}
