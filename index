#bar{position:fixed;top:env(safe-area-inset-top,0px);left:0;height:4px;background:var(--ac);transition:width .5s;z-index:5}
.pg{position:absolute;inset:0;padding:28px 22px 80px;overflow-y:auto;opacity:0;transform:translateX(60px);transition:.5s;pointer-events:none;display:flex;flex-direction:column;align-items:center}
.pg.on{opacity:1;transform:none;pointer-events:auto}.pg.off{transform:translateX(-60px)}
.in{width:100%;max-width:680px}
.big{font-size:64px;animation:fl 3s ease-in-out infinite}@keyframes fl{50%{transform:translateY(-10px)}}
.no{color:var(--ac);font-weight:700;letter-spacing:2px}
h1,h2{margin:.2em 0}h2{font-size:30px}p{color:var(--mu);font-size:17px;line-height:1.7}
.on .in>*{animation:up .6s both}.on .in>*:nth-child(2){animation-delay:.1s}.on .in>*:nth-child(3){animation-delay:.2s}.on .in>*:nth-child(4){animation-delay:.3s}
@keyframes up{from{opacity:0;transform:translateY(20px)}}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:14px}
.card{background:var(--cd);border:2px solid transparent;border-radius:16px;padding:14px;cursor:pointer;transition:.25s;box-shadow:0 2px 10px #0002}
.card:hover{transform:translateY(-3px)}.card.open{border-color:var(--ac)}
.card b{display:block;font-size:17px}.card span{display:none;color:var(--mu);font-size:15px;margin-top:6px;line-height:1.5}.card.open span{display:block;animation:up .3s}
.card i{font-style:normal;font-size:28px;display:block}
.flow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px}
.st{background:var(--cd);border-radius:14px;padding:12px 14px;text-align:center;box-shadow:0 2px 10px #0002;font-size:15px;opacity:0}
.st i{font-style:normal;font-size:26px;display:block}.ar{color:var(--ac);font-size:22px;opacity:0}
.on .st,.on .ar{animation:pop .5s forwards;animation-delay:calc(var(--d)*.25s + .4s)}@keyframes pop{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:none}}
.mt{background:var(--cd);border-radius:16px;padding:18px;margin-top:16px}
.tr{height:26px;background:#8883;border-radius:13px;overflow:hidden}.fl{height:100%;width:30%;background:linear-gradient(90deg,var(--ac2),var(--ac));transition:.3s}
input[type=range]{width:100%;margin:14px 0}
.mc{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:14px}
.sw{padding:10px 14px;border-radius:20px;background:var(--cd);border:2px solid #8885;cursor:pointer;font:inherit;color:var(--fg);transition:.3s}
.sw.c{border-color:var(--ac);background:var(--ac);color:#fff;transform:scale(1.07)}
#hub{font-size:54px;text-align:center;margin-top:14px;transition:.3s}
nav{position:fixed;bottom:0;left:0;right:0;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));display:flex;justify-content:space-between;align-items:center;background:linear-gradient(transparent,var(--bg) 40%);z-index:4}
nav button{width:48px;height:48px;border-radius:50%;border:0;background:var(--ac);color:#fff;font-size:22px;cursor:pointer}
#dots{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:60vw}#dots b{width:9px;height:9px;border-radius:50%;background:#8886;cursor:pointer}#dots b.on{background:var(--ac);transform:scale(1.4)}
.tx{margin-top:24px;border-left:4px solid var(--ac);padding-left:16px}.tx p{color:var(--fg);font-size:18px;line-height:1.9;margin:.7em 0}.ls{margin:18px 0 0;padding:0;list-style:none}.ls li{background:var(--cd);border-radius:12px;padding:10px 14px;margin:8px 0;font-size:16px;box-shadow:0 2px 8px #0002}.ls li:before{content:"✔ ";color:var(--ac)}.ex{margin-top:14px;padding:14px;border-radius:14px;border:2px dashed var(--ac);font-size:16px;line-height:1.7}.ex:before{content:"💡 উদাহরণ: ";font-weight:700;color:var(--ac)}</style></head><body>
